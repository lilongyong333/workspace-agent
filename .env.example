# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除。
# ---------------------------------------------------------------

# 模型提供方：deepseek | openai | gemini | zhipu | anthropic
LLM_PROVIDER=deepseek
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=https://api.deepseek.com

# 循环安全阀
AGENT_MAX_STEPS=40
AGENT_TOKEN_BUDGET=200000
AGENT_TOOL_RESULT_MAX_BYTES=8192

# Web Demo 防滥用
DEMO_ACCESS_CODE=              # 访问口令，留空则不校验（仅限本地）
DEMO_RATE_LIMIT_PER_HOUR=20    # 单 IP 每小时任务数
DEMO_MAX_TOKENS_PER_TASK=150000 # 单次任务 token 硬上限（原 80000 太紧，正经指令跑不完就 DEGRADED）
DEMO_DAILY_TOKEN_BUDGET=2000000 # 全局日预算，超出后拒绝新任务

# ── 视觉解析（扫描件 PDF / 图片）────────────────────────────
# 默认关闭：每页一次模型调用，慢且花钱。有文本层的 PDF 永远不会走这条路。
VISION_OCR=0
VISION_PROVIDER=qwen
VISION_MODEL=qwen-vl-max
VISION_MAX_PAGES=12

# 通义千问（阿里云百炼）。配了它，Web 端模型选择器就会多一个选项。
QWEN_API_KEY=
QWEN_MODEL=qwen-vl-max
