# =============================================================
# 注意：.gitignore 的 # 只有在【行首】才是注释。
# 写成 `/workspace/   # 说明` 会让整行（含空格与说明文字）
# 变成模式本身，结果是什么都匹配不到 —— 而且 git 不会报错，
# 只会在你 commit 之后才发现产物全被提交了。
# 所以本文件的所有注释都独占一行。
# =============================================================

# -------- 密钥：绝不入库 --------
.env
.env.*
!.env.example

# -------- Python --------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ruff_cache/

# -------- 运行期产物 --------
# Web 端每会话的独立工作副本
/sessions/
# 本地跑 CLI 时的可写工作目录（只读种子是 workspace_seed/）
/workspace/
# 轨迹输出（trace.jsonl / trace-t2.jsonl / 任何 *.jsonl 轨迹）
trace*.jsonl
.artifacts/

# -------- 编辑器 / 系统 --------
.idea/
.vscode/*
!.vscode/extensions.json
.DS_Store
Thumbs.db
